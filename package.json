{
  "name": "zhangrh-shop",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node automation/publish/workspace-runner.mjs dev",
    "publish": "node automation/publish/workspace-runner.mjs publish",
    "test:automation": "node --test automation/publish/*.test.mjs",
    "test": "npm run test:automation && npm --prefix frontend test && npm --prefix backend test",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build:all",
    "check": "npm test && npm run lint && npm run typecheck && npm run build"
  }
}
